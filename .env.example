# Browser-safe values (the NEXT_PUBLIC_ prefix is an explicit public boundary)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LINE_LIFF_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values; never expose these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SESSION_SIGNING_SECRET=
UPLOAD_SIGNING_SECRET=

# Asymmetric key used only by the server to mint <=5 minute customer DB JWTs.
# Store the private key in the deployment secret manager; configure the public key in Supabase.
CUSTOMER_DB_JWT_PRIVATE_KEY=
CUSTOMER_DB_JWT_KEY_ID=
CUSTOMER_DB_JWT_ISSUER=
