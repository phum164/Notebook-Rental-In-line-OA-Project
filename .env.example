# Browser-safe values (the NEXT_PUBLIC_ prefix is an explicit public boundary)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LINE_LIFF_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Equivalent public-key name accepted by the server runtime.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values; never expose these with NEXT_PUBLIC_
# Bootstrap tooling/background jobs only; forbidden in normal HTTP and session paths.
SUPABASE_SERVICE_ROLE_KEY=
# LINE Login channel containing the LIFF app; used as the login-token audience.
LINE_CHANNEL_ID=
# Messaging API channel secret for the approved OA, not the LINE Login secret.
LINE_CHANNEL_SECRET=
# Messaging API access token from that same approved OA/channel; server worker only.
LINE_CHANNEL_ACCESS_TOKEN=
# Enable only after D-13 approval; policy includes its approvalReference and allowlisted event templates.
LINE_NOTIFICATIONS_ENABLED=false
LINE_NOTIFICATION_POLICY_JSON=
# Server-only bearer token (at least 32 characters) for GET /api/internal/line.
CRON_SECRET=
SESSION_SIGNING_SECRET=
# Supabase OAuth provider enabled for admin login; e.g. google or azure.
SUPABASE_AUTH_PROVIDER=
UPLOAD_SIGNING_SECRET=

# Asymmetric key used only by the server to mint <=5 minute customer DB JWTs
# and <=60 second app_session_service JWTs for the scoped session RPCs.
# Store the private key in the deployment secret manager; configure the public key in Supabase.
CUSTOMER_DB_JWT_PRIVATE_KEY=
CUSTOMER_DB_JWT_KEY_ID=
CUSTOMER_DB_JWT_ISSUER=
CUSTOMER_DB_JWT_AUDIENCE=

LINE_PRIVATE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
